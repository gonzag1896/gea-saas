generator client {
  provider      = "prisma-client-js"
  // Netlify compila en Ubuntu pero ejecuta las funciones en Lambda (Amazon
  // Linux). Sin el segundo target, el cliente se genera para el sistema
  // equivocado y en producción falla con "query engine not found".
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// Convención de multi-tenancy (Revisión técnica final, sección 1):
// toda tabla que cuelga de una Ferretería lleva su propio `ferreteriaId`
// (no solo el de su padre) para que cualquier consulta pueda filtrar sin
// necesidad de un join. Para que ese `ferreteriaId` denormalizado no pueda
// divergir del padre real, cada tabla tenant-scoped declara
// `@@unique([id, ferreteriaId])` y sus tablas hijas referencian al padre
// con una FK COMPUESTA `(padreId, ferreteriaId)`. Postgres rechaza el
// insert si no coinciden — es la base de datos, no la aplicación, la que
// garantiza que una fila nunca quede "cruzada" entre dos ferreterías.
// ============================================================

// ============================================================
// Autenticación (Auth.js / NextAuth v5). Fase 1 instala y tipa esto; el
// Credentials provider real (bcrypt, rate limiting, bloqueo por intentos)
// se implementa recién en Fase 3.
// ============================================================

enum EstadoUsuario {
  INVITADO // creado, sin password todavía, pendiente de aceptar invitación
  ACTIVO
  BLOQUEADO
  INACTIVO // desactivado, nunca se borra (referencias de auditoría)
}

model Usuario {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?

  // Nunca se mezcla con roles de ferretería (ver FerreteriaUsuario).
  isSuperAdmin Boolean       @default(false)
  estado       EstadoUsuario @default(INVITADO)

  // Freno de fuerza bruta persistido en base: en Netlify cada request puede
  // caer en una instancia distinta, un contador en memoria no frena nada.
  intentosFallidos Int       @default(0)
  bloqueadoHasta   DateTime?

  // Los tokens de sesión (JWT) se emiten y viven por su cuenta. Comparar
  // su fecha de emisión contra esta columna es lo único que permite cortar
  // una sesión antes de que expire sola cuando se cambia/resetea la clave.
  passwordCambiadoAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts Account[]
  sessions Session[]

  ferreterias FerreteriaUsuario[]
  auditLogs   AuditLog[]

  ventasRegistradas          Venta[]            @relation("VentaRegistradaPor")
  ventasAnuladas             Venta[]            @relation("VentaAnuladaPor")
  comprasRegistradas         Compra[]           @relation("CompraRegistradaPor")
  comprasAnuladas            Compra[]           @relation("CompraAnuladaPor")
  movimientosStock           MovimientoStock[]  @relation("MovimientoStockRegistradoPor")
  movimientosCC              CuentaCliente[]    @relation("CuentaClienteRegistradoPor")
  devolucionesCompra         DevolucionCompra[] @relation("DevolucionCompraRegistradoPor")
  devolucionesVenta          DevolucionVenta[]  @relation("DevolucionVentaRegistradoPor")
  cierresCaja                CierreCaja[]       @relation("CierreCajaRegistradoPor")
  cierresCajaEditados        CierreCaja[]       @relation("CierreCajaActualizadoPor")
  movimientosCP              CuentaProveedor[]  @relation("CuentaProveedorRegistradoPor")
  pagosPlataformaRegistrados PagoPlataforma[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  usuario Usuario @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  usuario Usuario @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Usado para recuperación de contraseña (Fase 3, vía Resend): el token que
// se manda por email es el valor en claro, pero lo que se guarda acá está
// hasheado — un volcado de esta tabla nunca da un link de reset utilizable.
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================
// Multi-tenant: cada Ferretería es un tenant.
// ============================================================

enum EstadoFerreteria {
  ACTIVO
  INACTIVO
}

model Ferreteria {
  id     String           @id @default(cuid())
  nombre String
  estado EstadoFerreteria @default(ACTIVO)

  // Identificador corto para URLs públicas futuras, en vez del id interno.
  slug String? @unique

  // Datos fiscales — no usados todavía (sin integración e-Factura), campo
  // reservado ahora porque agregarlo después es gratis y agregarlo más
  // tarde sobre datos ya cargados no lo es (decisión pendiente #5, cerrada).
  rut         String?
  razonSocial String?

  telefono      String?
  direccion     String?
  logoUrl       String?
  colorPrimario String?

  // Habilita/deshabilita módulos futuros por ferretería sin migraciones.
  moduleFlags Json?

  // Tipo de cambio configurado desde /configuracion — precarga el campo
  // "cotización" de Ventas/Compras en dólares, pero cada operación puede
  // pisarlo puntualmente (ver Venta.cotizacion/Compra.cotizacion). No es
  // la cotización "del día" automática: hay que guardarla a mano o
  // consultarla contra el BCU y confirmar, así nunca cambia un total ya
  // calculado por sorpresa.
  cotizacionDolar      Decimal?  @db.Decimal(10, 4)
  cotizacionDolarFecha DateTime?

  // Vigencia de la mensualidad que le cobra la plataforma a esta
  // ferretería. Campo cacheado (la fuente de verdad es la suma de
  // PagoPlataforma) para no recalcular en cada request si hoy está por
  // vencer — se recalcula solo al registrar un pago nuevo. Fecha
  // calendario, no timestamp (ver src/lib/fecha.ts sobre el bug de huso
  // horario ya resuelto en el resto del sistema).
  vigenciaHasta DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuarios        FerreteriaUsuario[]
  categorias      Categoria[]
  marcas          Marca[]
  clientes        Cliente[]
  proveedores     Proveedor[]
  productos       Producto[]
  compras         Compra[]
  ventas          Venta[]
  auditLogs       AuditLog[]
  cierresCaja     CierreCaja[]
  listasPrecio    ListaPrecio[]
  pagosPlataforma PagoPlataforma[]

  @@index([estado])
}

// Historial de cobros de la mensualidad de la plataforma (no es plata del
// negocio de la ferretería — es lo que Gonzalo le cobra a la ferretería
// por usar GEA). Cada pago extiende Ferreteria.vigenciaHasta un mes desde
// la vigencia anterior si todavía no había vencido (no se "pierden" días
// pagados de más por pagar temprano), o desde la fecha del pago si ya
// había vencido.
model PagoPlataforma {
  id           String @id @default(cuid())
  ferreteriaId String

  fecha         DateTime @db.Date // día en que se recibió el pago (o del que se otorga, si es gratis)
  monto         Decimal? @db.Decimal(10, 2)
  esGratis      Boolean  @default(false) // cortesía/promo, sin cobro real — no cuenta para el ingreso estimado
  vigenciaDesde DateTime @db.Date
  vigenciaHasta DateTime @db.Date

  registradoPorId String?

  createdAt DateTime @default(now())

  ferreteria    Ferreteria @relation(fields: [ferreteriaId], references: [id], onDelete: Cascade)
  registradoPor Usuario?   @relation(fields: [registradoPorId], references: [id])

  @@index([ferreteriaId])
}

enum RolFerreteria {
  DUENO
  CAJERO
  DEPOSITO
}

enum EstadoMembresia {
  ACTIVO
  INACTIVO
}

// Tabla puente: una persona puede trabajar en más de una ferretería, con un
// rol distinto en cada una. El rol vive en la relación, no en Usuario.
model FerreteriaUsuario {
  id           String          @id @default(cuid())
  ferreteriaId String
  usuarioId    String
  rol          RolFerreteria
  estado       EstadoMembresia @default(ACTIVO)

  createdAt DateTime @default(now())

  ferreteria Ferreteria @relation(fields: [ferreteriaId], references: [id], onDelete: Cascade)
  usuario    Usuario    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([ferreteriaId, usuarioId])
  @@index([usuarioId])
}

// ============================================================
// Catálogo
// ============================================================

model Categoria {
  id           String  @id @default(cuid())
  ferreteriaId String
  nombre       String
  activo       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ferreteria    Ferreteria     @relation(fields: [ferreteriaId], references: [id], onDelete: Cascade)
  subCategorias SubCategoria[]

  @@unique([id, ferreteriaId])
  @@unique([ferreteriaId, nombre])
}

model SubCategoria {
  id           String  @id @default(cuid())
  ferreteriaId String
  categoriaId  String
  nombre       String
  activo       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categoria Categoria  @relation(fields: [categoriaId, ferreteriaId], references: [id, ferreteriaId], onDelete: Cascade)
  productos Producto[]

  @@unique([id, ferreteriaId])
  @@unique([categoriaId, nombre])
  @@index([ferreteriaId])
}

model Marca {
  id           String  @id @default(cuid())
  ferreteriaId String
  nombre       String
  activo       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ferreteria Ferreteria @relation(fields: [ferreteriaId], references: [id], onDelete: Cascade)
  productos  Producto[]

  @@unique([id, ferreteriaId])
  @@unique([ferreteriaId, nombre])
}

enum Moneda {
  UYU
  USD
}

model Producto {
  id           String @id @default(cuid())
  ferreteriaId String

  codigo         String
  // Código de barras del producto (EAN/UPC u otro) — opcional, para el
  // escaneo rápido en Ventas/Compras. Distinto de `codigo` (el código
  // interno de catálogo, obligatorio y el que ya se usa en toda la app).
  codigoBarras   String?
  descripcion    String
  subCategoriaId String
  marcaId        String

  moneda      Moneda  @default(UYU)
  precioCosto Decimal @default(0) @db.Decimal(12, 2)
  precioVenta Decimal @default(0) @db.Decimal(12, 2)

  // stockActual es una proyección de MovimientoStock (única fuente de
  // verdad, ver esa tabla), mantenida en la misma transacción que cada
  // movimiento. `CHECK (stockActual >= 0)` se agrega en la migración
  // manual (decisión pendiente #1, cerrada: se bloquea stock negativo).
  stockActual Int @default(0)
  stockMinimo Int @default(0)

  fechaUltCompra              DateTime? @db.Date
  fechaUltActualizacionPrecio DateTime? @db.Date
  observaciones               String?
  activo                      Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ferreteria   Ferreteria   @relation(fields: [ferreteriaId], references: [id], onDelete: Cascade)
  subCategoria SubCategoria @relation(fields: [subCategoriaId, ferreteriaId], references: [id, ferreteriaId])
  marca        Marca        @relation(fields: [marcaId, ferreteriaId], references: [id, ferreteriaId])

  compraDetalles   CompraDetalle[]
  ventaDetalles    VentaDetalle[]
  movimientosStock MovimientoStock[]
  preciosPorLista  PrecioProducto[]

  @@unique([id, ferreteriaId])
  @@unique([ferreteriaId, codigo])
  @@unique([ferreteriaId, codigoBarras])
  @@index([ferreteriaId, subCategoriaId])
  @@index([ferreteriaId, marcaId])
}

// ============================================================
// Terceros
// ============================================================

model Cliente {
  id           String  @id @default(cuid())
  ferreteriaId String
  nombre       String
  telefono     String?
  activo       Boolean @default(true)

  // Null = precio base (Producto.precioVenta) — asignar una lista acá es
  // lo que hace que Ventas le sugiera el precio de esa lista en vez del
  // base al elegir un producto para este cliente. Sigue siendo editable
  // a mano en la línea, esto solo cambia el valor sugerido de partida.
  listaPrecioId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ferreteria    Ferreteria      @relation(fields: [ferreteriaId], references: [id], onDelete: Cascade)
  listaPrecio   ListaPrecio?    @relation(fields: [listaPrecioId, ferreteriaId], references: [id, ferreteriaId])
  ventas        Venta[]
  cuentaCliente CuentaCliente[]

  @@unique([id, ferreteriaId])
  @@index([ferreteriaId])
  @@index([ferreteriaId, listaPrecioId])
}

// Lista de precios (ej. "Mayorista") — un producto puede tener un precio
// distinto por lista vía PrecioProducto; si no tiene entrada ahí, se usa
// Producto.precioVenta (la lista "base" no es una fila, es la ausencia
// de override). Un cliente asignado a una lista sin overrides cargados
// simplemente ve los precios base en todo, como si no tuviera lista.
model ListaPrecio {
  id           String  @id @default(cuid())
  ferreteriaId String
  nombre       String
  activo       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ferreteria Ferreteria       @relation(fields: [ferreteriaId], references: [id], onDelete: Cascade)
  precios    PrecioProducto[]
  clientes   Cliente[]

  @@unique([id, ferreteriaId])
  @@unique([ferreteriaId, nombre])
}

model PrecioProducto {
  id            String @id @default(cuid())
  ferreteriaId  String
  listaPrecioId String
  productoId    String

  precio Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listaPrecio ListaPrecio @relation(fields: [listaPrecioId, ferreteriaId], references: [id, ferreteriaId], onDelete: Cascade)
  producto    Producto    @relation(fields: [productoId, ferreteriaId], references: [id, ferreteriaId], onDelete: Cascade)

  @@unique([id, ferreteriaId])
  @@unique([ferreteriaId, listaPrecioId, productoId])
}

model Proveedor {
  id           String  @id @default(cuid())
  ferreteriaId String
  nombre       String
  // UNIQUE parcial (ferreteriaId, rut) WHERE rut IS NOT NULL — Prisma no
  // soporta índices únicos parciales en el DSL, se agrega en la migración
  // manual junto con los CHECK constraints.
  rut          String?
  telefono     String?
  email        String?
  activo       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ferreteria      Ferreteria        @relation(fields: [ferreteriaId], references: [id], onDelete: Cascade)
  compras         Compra[]
  cuentaProveedor CuentaProveedor[]

  @@unique([id, ferreteriaId])
  @@index([ferreteriaId])
}

// ============================================================
// Compras
// ============================================================

enum EstadoOperacion {
  PENDIENTE
  CONFIRMADO
  ANULADO
}

enum TipoIva {
  EXENTO // 0%
  TOTAL // 22%
}

model Compra {
  id           String @id @default(cuid())
  ferreteriaId String
  proveedorId  String

  fecha         DateTime        @db.Date
  // UNIQUE parcial (ferreteriaId, proveedorId, numeroFactura) WHERE
  // numeroFactura IS NOT NULL — migración manual, mismo motivo que Proveedor.rut.
  numeroFactura String?
  facturaPdfUrl String?
  estado        EstadoOperacion @default(PENDIENTE)
  // CONTADO (default) no genera deuda; CREDITO abre un Debe en la cuenta
  // corriente del proveedor al confirmar la compra — espejo de lo que
  // Venta.medioPago hace con la cuenta corriente del cliente.
  medioPago     MedioPago       @default(CONTADO)
  observaciones String?

  subtotal Decimal @default(0) @db.Decimal(12, 2)
  iva      Decimal @default(0) @db.Decimal(12, 2)
  total    Decimal @default(0) @db.Decimal(12, 2)

  registradoPorUsuarioId String?
  anuladoPorUsuarioId    String?
  anuladoAt              DateTime?
  motivoAnulacion        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ferreteria    Ferreteria @relation(fields: [ferreteriaId], references: [id], onDelete: Cascade)
  proveedor     Proveedor  @relation(fields: [proveedorId, ferreteriaId], references: [id, ferreteriaId])
  registradoPor Usuario?   @relation("CompraRegistradaPor", fields: [registradoPorUsuarioId], references: [id])
  anuladoPor    Usuario?   @relation("CompraAnuladaPor", fields: [anuladoPorUsuarioId], references: [id])

  detalle CompraDetalle[]

  @@unique([id, ferreteriaId])
  @@index([ferreteriaId, fecha])
  @@index([ferreteriaId, estado])
}

model CompraDetalle {
  id           String @id @default(cuid())
  ferreteriaId String
  compraId     String
  productoId   String

  // CHECK (cantidad > 0) — migración manual.
  cantidad      Int
  costoUnitario Decimal @db.Decimal(12, 2)
  // Puntos porcentuales (0-100), no un monto en $ — igual criterio que
  // VentaDetalle.descuento.
  descuento     Decimal @default(0) @db.Decimal(5, 2)
  tipoIva       TipoIva @default(EXENTO)
  subtotal      Decimal @db.Decimal(12, 2)

  compra       Compra             @relation(fields: [compraId, ferreteriaId], references: [id, ferreteriaId], onDelete: Cascade)
  producto     Producto           @relation(fields: [productoId, ferreteriaId], references: [id, ferreteriaId])
  devoluciones DevolucionCompra[]

  @@unique([id, ferreteriaId])
  @@index([compraId])
  @@index([ferreteriaId, productoId])
}

model DevolucionCompra {
  id              String @id @default(cuid())
  ferreteriaId    String
  compraDetalleId String

  // CHECK (cantidad > 0) — migración manual.
  cantidad Int
  motivo   String?

  registradoPorUsuarioId String?
  createdAt              DateTime @default(now())

  compraDetalle CompraDetalle @relation(fields: [compraDetalleId, ferreteriaId], references: [id, ferreteriaId])
  registradoPor Usuario?      @relation("DevolucionCompraRegistradoPor", fields: [registradoPorUsuarioId], references: [id])

  @@index([compraDetalleId])
}

// ============================================================
// Ventas
// ============================================================

enum MedioPago {
  CONTADO
  CREDITO
  TRANSFERENCIA
  DEBITO
}

model Venta {
  id           String @id @default(cuid())
  ferreteriaId String
  clienteId    String

  fecha     DateTime        @db.Date
  estado    EstadoOperacion @default(PENDIENTE)
  medioPago MedioPago       @default(CONTADO)

  subtotal Decimal @default(0) @db.Decimal(12, 2)
  iva      Decimal @default(0) @db.Decimal(12, 2)
  entrega  Decimal @default(0) @db.Decimal(12, 2)
  total    Decimal @default(0) @db.Decimal(12, 2)

  registradoPorUsuarioId String?
  anuladoPorUsuarioId    String?
  anuladoAt              DateTime?
  motivoAnulacion        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ferreteria    Ferreteria @relation(fields: [ferreteriaId], references: [id], onDelete: Cascade)
  cliente       Cliente    @relation(fields: [clienteId, ferreteriaId], references: [id, ferreteriaId])
  registradoPor Usuario?   @relation("VentaRegistradaPor", fields: [registradoPorUsuarioId], references: [id])
  anuladoPor    Usuario?   @relation("VentaAnuladaPor", fields: [anuladoPorUsuarioId], references: [id])

  detalle VentaDetalle[]

  @@unique([id, ferreteriaId])
  @@index([ferreteriaId, fecha])
  @@index([ferreteriaId, estado])
}

model VentaDetalle {
  id           String @id @default(cuid())
  ferreteriaId String
  ventaId      String
  productoId   String

  precio           Decimal @db.Decimal(12, 2)
  // Puntos porcentuales (0-100), no un monto en $ — se aplica sobre
  // precio*cantidad al calcular `total`.
  descuento        Decimal @default(0) @db.Decimal(5, 2)
  // IVA por línea, no por venta entera — mismo criterio que ya usaba
  // CompraDetalle.tipoIva (dos productos de la misma venta pueden tener
  // tratamiento de IVA distinto). Reemplaza al viejo Venta.tipoIva.
  tipoIva          TipoIva @default(EXENTO)
  // CHECK (cantidad > 0), CHECK (cantidadDevuelta <= cantidad) — migración manual.
  cantidad         Int
  cantidadDevuelta Int     @default(0)
  total            Decimal @db.Decimal(12, 2)
  totalVigente     Decimal @db.Decimal(12, 2)

  venta        Venta             @relation(fields: [ventaId, ferreteriaId], references: [id, ferreteriaId], onDelete: Cascade)
  producto     Producto          @relation(fields: [productoId, ferreteriaId], references: [id, ferreteriaId])
  devoluciones DevolucionVenta[]

  @@unique([id, ferreteriaId])
  @@index([ventaId])
  @@index([ferreteriaId, productoId])
}

model DevolucionVenta {
  id             String @id @default(cuid())
  ferreteriaId   String
  ventaDetalleId String

  // CHECK (cantidad > 0) — migración manual.
  cantidad Int
  motivo   String?

  registradoPorUsuarioId String?
  createdAt              DateTime @default(now())

  ventaDetalle  VentaDetalle @relation(fields: [ventaDetalleId, ferreteriaId], references: [id, ferreteriaId])
  registradoPor Usuario?     @relation("DevolucionVentaRegistradoPor", fields: [registradoPorUsuarioId], references: [id])

  @@index([ventaDetalleId])
}

// ============================================================
// Stock — MovimientoStock es la única fuente de verdad; Producto.stockActual
// es una proyección mantenida en la misma transacción que cada movimiento.
// ============================================================

enum TipoMovimientoStock {
  ENTRADA
  SALIDA
  AJUSTE_POSITIVO
  AJUSTE_NEGATIVO
}

enum OrigenMovimientoStock {
  COMPRA
  VENTA
  AJUSTE
  DEVOLUCION_COMPRA
  DEVOLUCION_VENTA
}

model MovimientoStock {
  id           String @id @default(cuid())
  ferreteriaId String
  productoId   String

  fecha    DateTime            @db.Date
  tipo     TipoMovimientoStock
  cantidad Int
  motivo   String?

  // Referencia polimórfica (Compra/Venta/Ajuste/Devolución) sin FK de base
  // — validada en la capa de dominio, no en el esquema.
  origenTipo OrigenMovimientoStock
  origenId   String?

  registradoPorUsuarioId String?
  createdAt              DateTime @default(now())

  producto      Producto @relation(fields: [productoId, ferreteriaId], references: [id, ferreteriaId])
  registradoPor Usuario? @relation("MovimientoStockRegistradoPor", fields: [registradoPorUsuarioId], references: [id])

  @@unique([id, ferreteriaId])
  @@index([ferreteriaId, productoId, fecha])
  @@index([origenTipo, origenId])
}

// ============================================================
// Cuenta corriente de clientes — libro mayor a partida doble, append-only
// (ninguna operación de negocio hace UPDATE/DELETE acá; una reversión es
// una fila nueva de signo contrario).
// ============================================================

enum OrigenCuentaCliente {
  VENTA_CREDITO
  // Una venta Contado o Débito también queda asentada acá -- como un Debe
  // y un Haber por el mismo monto y fecha (dos filas: nunca una sola fila
  // con ambos, ver el CHECK de más abajo) -- para que la cuenta corriente
  // sea el historial completo de lo que le vendiste a un cliente, no solo
  // lo que te debe. El saldo neto no se mueve: ya está cobrada.
  VENTA_CONTADO
  COBRO
  DEVOLUCION_VENTA
  ANULACION_VENTA_CREDITO
}

model CuentaCliente {
  id           String @id @default(cuid())
  ferreteriaId String
  clienteId    String

  fecha DateTime @db.Date
  // CHECK (debe >= 0 AND haber >= 0), CHECK (debe = 0 OR haber = 0) —
  // migración manual: una fila es débito o crédito, nunca ambos ni negativa.
  debe  Decimal  @default(0) @db.Decimal(12, 2)
  haber Decimal  @default(0) @db.Decimal(12, 2)

  origenTipo OrigenCuentaCliente
  origenId   String?
  referencia String?
  // Solo tiene sentido (y solo se completa) en un COBRO — CONTADO o
  // TRANSFERENCIA, nunca CREDITO. Null en todo lo demás (ventas a
  // crédito, devoluciones) y también en cobros de antes de este campo.
  // El Cierre de Caja del día solo suma los COBRO en CONTADO: son los
  // únicos que efectivamente entran como billete a la caja física.
  medioPago  MedioPago?

  registradoPorUsuarioId String?
  createdAt              DateTime @default(now())

  cliente       Cliente  @relation(fields: [clienteId, ferreteriaId], references: [id, ferreteriaId])
  registradoPor Usuario? @relation("CuentaClienteRegistradoPor", fields: [registradoPorUsuarioId], references: [id])

  @@unique([id, ferreteriaId])
  @@index([ferreteriaId, clienteId, fecha])
}

enum OrigenCuentaProveedor {
  COMPRA_CREDITO
  // Espejo de VENTA_CONTADO del lado de compras -- una compra Contado o
  // Débito queda asentada como Debe + Haber por el mismo monto, para que
  // la cuenta corriente del proveedor sea el historial completo de lo que
  // le compraste, no solo lo que le debés.
  COMPRA_CONTADO
  PAGO
  DEVOLUCION_COMPRA
  ANULACION_COMPRA_CREDITO
}

// Espejo exacto de CuentaCliente pero del otro lado del mostrador: acá el
// Debe es lo que le debemos al proveedor (compra a crédito) y el Haber lo
// que le pagamos. Mismo criterio append-only: ninguna operación hace
// UPDATE/DELETE, una reversión es una fila nueva de signo contrario.
model CuentaProveedor {
  id           String @id @default(cuid())
  ferreteriaId String
  proveedorId  String

  fecha DateTime @db.Date
  debe  Decimal  @default(0) @db.Decimal(12, 2)
  haber Decimal  @default(0) @db.Decimal(12, 2)

  origenTipo OrigenCuentaProveedor
  origenId   String?
  referencia String?
  medioPago  MedioPago?

  registradoPorUsuarioId String?
  createdAt              DateTime @default(now())

  proveedor     Proveedor @relation(fields: [proveedorId, ferreteriaId], references: [id, ferreteriaId])
  registradoPor Usuario?  @relation("CuentaProveedorRegistradoPor", fields: [registradoPorUsuarioId], references: [id])

  @@unique([id, ferreteriaId])
  @@index([ferreteriaId, proveedorId, fecha])
}

// Cierre de Caja: una foto del día — cuánto "debería" haber en la caja
// según el sistema (ventas Contado confirmadas + cobros en Contado) contra
// lo que el cajero contó físicamente. La diferencia queda guardada para
// siempre, no se recalcula después — si una venta de ese día se anula
// más tarde, el cierre ya cerrado no se toca (mismo criterio de
// trazabilidad append-only que el resto del sistema).
model CierreCaja {
  id           String   @id @default(cuid())
  ferreteriaId String
  // `fecha` es el inicio del período cerrado y `fechaHasta` el fin
  // (inclusive) -- para un cierre de un solo día, los dos valores son
  // iguales. Permite cerrar varios días de una vez si la caja quedó sin
  // cerrar un tramo (ferretería cerrada, cajero de licencia, etc.), sin
  // necesitar un modelo aparte para "cierre múltiple".
  fecha        DateTime @db.Date
  fechaHasta   DateTime @db.Date

  // Efectivo con el que se arrancó el período (vuelto/fondo de caja) --
  // se suma a lo vendido/cobrado Contado para calcular el esperado. No
  // existía antes: sin esto, el "esperado" asumía que la caja arrancaba
  // siempre en $0.
  montoInicial       Decimal @default(0) @db.Decimal(12, 2)
  totalVentasContado Decimal @db.Decimal(12, 2)
  totalCobrosContado Decimal @db.Decimal(12, 2)
  totalEsperado      Decimal @db.Decimal(12, 2)
  totalContado       Decimal @db.Decimal(12, 2)
  diferencia         Decimal @db.Decimal(12, 2)
  observaciones      String?

  registradoPorUsuarioId  String?
  createdAt               DateTime @default(now())
  actualizadoPorUsuarioId String?
  updatedAt               DateTime @updatedAt

  ferreteria     Ferreteria @relation(fields: [ferreteriaId], references: [id], onDelete: Cascade)
  registradoPor  Usuario?   @relation("CierreCajaRegistradoPor", fields: [registradoPorUsuarioId], references: [id])
  actualizadoPor Usuario?   @relation("CierreCajaActualizadoPor", fields: [actualizadoPorUsuarioId], references: [id])

  // Ya no hay un UNIQUE de (ferreteriaId, fecha): con cierres por rango,
  // dos períodos válidos pueden compartir ferretería sin compartir fecha
  // exacta de inicio. Que ningún día quede cubierto por dos cierres a la
  // vez es una regla de negocio (se valida a mano en registrarCierreCaja
  // antes de crear), no algo que un UNIQUE de columnas alcance a expresar.
  @@index([ferreteriaId, fecha])
}

// ============================================================
// Auditoría y rate limiting
// ============================================================

model AuditLog {
  id           String  @id @default(cuid())
  usuarioId    String?
  ferreteriaId String?

  accion    String
  entidad   String?
  entidadId String?
  // `detalle` nunca lleva password/passwordHash/token — el helper auditar()
  // los descarta antes de serializar, como red además de la disciplina de
  // cada caso de uso.
  detalle   Json?

  ip        String?
  userAgent String?

  createdAt DateTime @default(now())

  usuario    Usuario?    @relation(fields: [usuarioId], references: [id])
  ferreteria Ferreteria? @relation(fields: [ferreteriaId], references: [id])

  @@index([ferreteriaId, createdAt])
  @@index([usuarioId])
}

// Freno de abuso por IP/clave en rutas sin sesión (login, reset de
// contraseña). Ventana fija: una fila por (clave, ventana) que se
// incrementa; no hace falta job de limpieza, el volumen es chico y las
// filas viejas no se vuelven a leer.
model RateLimit {
  id       String   @id @default(cuid())
  clave    String
  ventana  DateTime
  cantidad Int      @default(1)

  @@unique([clave, ventana])
}
