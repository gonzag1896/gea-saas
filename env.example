# Postgres local (docker compose) o Supabase en producción.
# DIRECT_URL se usa solo para migraciones (Prisma necesita una conexión sin
# pooler para eso); en local, ambas apuntan a lo mismo.
DATABASE_URL="postgresql://postgres:postgres@localhost:5435/gea"
DIRECT_URL="postgresql://postgres:postgres@localhost:5435/gea"

# Auth.js — generar con: npx auth secret
AUTH_SECRET=""

# Resend (recuperación de contraseña — Fase 3)
RESEND_API_KEY=""
EMAIL_FROM="GEA <no-responder@tudominio.com>"
